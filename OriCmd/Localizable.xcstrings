            "value": "«%@»"
          }
        }
      }
    },
    "“%@” already exists.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже существует."
          }
        }
      }
    },
    "“%@” as text for mail:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» как текст для почты:"
          }
        }
      }
    },
    "“%@” failed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» завершилась с ошибкой"
          }
        }
      }
    },
    "“%@” is a folder on one side and a file on the other.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — папка с одной стороны и файл с другой."
          }
        }
      }
    },
    "“%@” is a solid RAR 4 archive, which the system libarchive cannot unpack. Install The Unarchiver's command line tools (brew install unar): OriCmd then uses them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — непрерывный (solid) архив RAR 4, его системная libarchive распаковать не может. Установите инструменты командной строки The Unarchiver (brew install unar) — OriCmd будет пользоваться ими."
          }
        }
      }
    },
    "“%@” is damaged: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» повреждён: %@"
          }
        }
      }
    },
    "“%@” is encrypted: OriCmd can unpack encrypted zip archives only, not 7z or RAR ones.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» зашифрован: OriCmd распаковывает только зашифрованные zip-архивы, не 7z и не RAR."
          }
        }
      }
    },
    "“%@” is encrypted: a password is needed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» зашифрован: нужен пароль."
          }
        }
      }
    },
    "“%@” is locked. Turn on “Overwrite/delete locked files” to replace it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» заблокирован. Чтобы заменить его, включите «Перезаписывать/удалять заблокированные файлы»."
          }
        }
      }
    },
    "“%@” is not bigger than one piece.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не больше одной части."
          }
        }
      }
    },
    "“%@” is still running in the terminal": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В терминале ещё работает «%@»"
          }
        }
      }
    },
    "“%@” was changed by another program meanwhile; nothing was written.": {
      "localizations": {
        "ru": {
