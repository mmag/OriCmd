    "%lld found, %lld scanned": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "найдено: %1$lld, просмотрено: %2$lld"
          }
        }
      }
    },
    "%lld of %lld files will be renamed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет переименовано файлов: %1$lld из %2$lld"
          }
        }
      }
    },
    "%lld → , %lld ← , %lld ≠ , %lld files compared; %@ to copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld → , %2$lld ← , %3$lld ≠ , сравнено файлов: %4$lld; копировать %5$@"
          }
        }
      }
    },
