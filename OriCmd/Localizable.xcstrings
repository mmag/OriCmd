          "stringUnit": {
            "state": "translated",
            "value": "Проверка архивов"
          }
        }
      }
    },
    "That would make more than 999 pieces: choose bigger ones.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получится больше 999 частей: выберите части побольше."
          }
        }
      }
    },
    "The archive cannot be put inside a folder being packed.": {
      "localizations": {
        "ru": {
