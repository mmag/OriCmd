      }
    },
    "The compared files were changed here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравниваемые файлы были изменены здесь."
          }
        }
      }
    },
    "The directory hotlist is empty": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список избранных каталогов пуст"
          }
