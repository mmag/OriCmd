{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%lld more queued)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (ещё в очереди: %2$lld)"
          }
        }
      }
    },
    "%@ (default)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (по умолчанию)"
          }
        }
      }
    },
    "%@ already exists. Replace?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже существует. Заменить?"
          }
        }
      }
    },
    "%@ bytes": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ байт"
          }
        }
      }
    },
    "%@ k / %@ k in %lld / %lld file(s), %lld / %lld dir(s)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Кб из %2$@ Кб, файлов: %3$lld из %4$lld, папок: %5$lld из %6$lld"
          }
        }
      }
    },
    "%@ k of %@ k free": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Кб из %2$@ Кб свободно"
          }
        }
      }
    },
    "%P folder of the active panel, %N file under the cursor, %S selected files, %T folder of the other panel, %M file under the cursor there. Values are quoted for the shell.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%P — каталог активной панели, %N — файл под курсором, %S — выделенные файлы, %T — каталог другой панели, %M — файл под курсором в ней. Значения экранируются для оболочки."
          }
        }
      }
    },
    "%lld OK, %lld mismatched, %lld missing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "в порядке: %1$lld, не совпало: %2$lld, отсутствует: %3$lld"
          }
        }
      }
    },
    "%lld archives": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "архивов: %lld"
          }
        }
      }
    },
    "%lld conflicting names": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтующих имён: %lld"
          }
        }
      }
    },
    "%lld files/folders": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "объектов: %lld"
          }
        }
